# backend の環境変数サンプル。
# このファイルをコピーして backend/.env を作る (.env はコミットしない)。
#   cp .env.example .env

# アプリ表示名
APP_NAME=my-app backend

# DB接続文字列。
# 開発 (SQLite):
DATABASE_URL=sqlite:///./app.db
# 本番 (PostgreSQL) の例:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/myapp

# CORSで許可するフロントエンドのオリジン (カンマ区切り)。
# 本番では実際のドメインを指定する。"*" は使わない。
CORS_ORIGINS=http://localhost:3000
